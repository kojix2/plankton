{
  "name": "plankton",
  "version": "0.1.0",
  "private": true,
  "description": "A browser-only Crystal/Wasm visual synthesizer with a Hydra-inspired DSL",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "presets": "node scripts/seed-previews.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "test:wasm": "node scripts/test-wasm.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:playwright": "playwright test",
    "build": "node scripts/build.mjs",
    "build:cdn": "node scripts/build.mjs --cdn",
    "dev": "node scripts/serve.mjs",
    "lint:crystal": "crystal run lib/ameba/bin/ameba.cr",
    "test:crystal": "crystal spec"
  },
  "dependencies": {
    "@live-codes/crystal-wasm": "https://github.com/kojix2/browser-crystal/releases/download/libgc-31842b9/live-codes-crystal-wasm-0.4.0.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  },
  "crystalWasm": {
    "version": "0.4.0",
    "repository": "kojix2/browser-crystal",
    "commit": "31842b98e395a818a9351b370f41c5f26f4861f5"
  }
}
